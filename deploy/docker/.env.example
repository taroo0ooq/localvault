# Copy to deploy/docker/.env (gitignored) — never commit real values.

# Publish binding for vault-api host port
# Tunnel mode (recommended): 127.0.0.1:8443
# LAN-only discovery: 0.0.0.0:8443
VAULT_PUBLISH=127.0.0.1:8443

# Set to 1 when cloudflared or ngrok is running
VAULT_TUNNEL_MODE=0

# Public HTTPS URL clients should use (Cloudflare hostname or ngrok URL)
VAULT_PUBLIC_BASE_URL=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ngrok authtoken (dashboard)
NGROK_AUTHTOKEN=
# Optional reserved domain
NGROK_DOMAIN=
